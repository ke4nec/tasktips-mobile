# 正式签名配置示例：复制为 android/keystore.properties 后填入真实值。
# 该文件含私钥口令，禁止入库（.gitignore 已排除）。
# keystore 文件放 android/release.keystore（storeFile 相对 android/app/ 模块目录解析）。
# CI 由 Secrets（KEYSTORE_BASE64 / KEYSTORE_PASSWORD）在构建前自动生成同名文件，
# 本文件仅用于本地构建；口令生成与备份说明见 docs/release-signing.md。
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=tasktips
keyPassword=CHANGE_ME
